<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/instructions"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_idle"
        android:textColor="@color/accent"
        android:textSize="15sp"
        android:padding="12dp"
        android:background="@color/surface" />

    <TextView
        android:id="@+id/usbText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="USB: none"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/rootText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Root: checking…"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:paddingBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExploit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_exploit" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReset"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_reset"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mode_label"
        android:textColor="@color/text"
        android:textStyle="bold"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />

    <RadioGroup
        android:id="@+id/modeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/modeRootless"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mode_rootless"
            android:textColor="@color/text"
            android:checked="true" />

        <RadioButton
            android:id="@+id/modeRootful"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mode_rootful"
            android:textColor="@color/text" />
    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnJailbreak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_jailbreak"
        android:layout_marginTop="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_cancel"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Log"
        android:textColor="@color/text"
        android:textStyle="bold"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:padding="8dp">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:typeface="monospace"
            android:textIsSelectable="true"
            android:text="" />
    </ScrollView>
</LinearLayout>
