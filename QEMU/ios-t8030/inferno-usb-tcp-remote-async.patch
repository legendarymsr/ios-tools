+/*
+ * ios-tools: ids cancelled on the iOS side whose cancel ack
+ * (USB_RET_REMOVE_FROM_QUEUE) has not arrived yet. Every response for such an
+ * id is stale and dropped, so it can never complete a newer packet that the
+ * guest submitted with the same id (xHCI reuses TRB addresses as ids).
+ */
+typedef struct USBTCPDrain {
+    int      pid;
+    uint8_t  ep;
+    uint64_t id;
+    unsigned count;
+} USBTCPDrain;
+
+static USBTCPDrain* usb_tcp_remote_find_drain(USBTCPRemoteState* s, int pid, uint8_t ep, uint64_t id)
+{
+    for (GList* l = s->drain_list; l != NULL; l = l->next) {
+        USBTCPDrain* d = l->data;
+        if (d->pid == pid && d->ep == ep && d->id == id) { return d; }
+    }
+    return NULL;
+}
+
+static void usb_tcp_remote_add_drain(USBTCPRemoteState* s, int pid, uint8_t ep, uint64_t id)
+{
+    USBTCPDrain* d = usb_tcp_remote_find_drain(s, pid, ep, id);
+
+    if (d == NULL) {
+        d      = g_new0(USBTCPDrain, 1);
+        d->pid = pid;
+        d->ep  = ep;
+        d->id  = id;
+        s->drain_list = g_list_prepend(s->drain_list, d);
+    }
+    d->count++;
+}
+
+static void usb_tcp_remote_clear_drain(USBTCPRemoteState* s)
+{
+    g_list_free_full(s->drain_list, g_free);
+    s->drain_list = NULL;
+}
+
+static void usb_tcp_remote_clean_inflight_queue(USBTCPRemoteState* s)
+{
+    USBTCPInflightPacket* p;
+    USBDevice*            dev = USB_DEVICE(s);
+
+    QEMU_LOCK_GUARD(&s->queue_mutex);
+
+    while (!QTAILQ_EMPTY(&s->queue)) {
+        p = QTAILQ_FIRST(&s->queue);
+        QTAILQ_REMOVE(&s->queue, p, queue);
+
+        /*
+         * Do not complete here: the packet may be queued behind others on its
+         * endpoint (usb_packet_complete asserts it is first) or not async at
+         * all. The detach in usb_tcp_remote_cleanup makes the host controller
+         * cancel every outstanding packet.
+         */
+        (void)dev;
+        g_free(p);
     }
 }
 
