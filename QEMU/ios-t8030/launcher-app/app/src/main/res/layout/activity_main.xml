<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@color/bg">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textColor="@color/text"
        android:textSize="22sp" android:textStyle="bold" android:paddingBottom="6dp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/instructions" android:textColor="@color/muted"
        android:textSize="12sp" android:paddingBottom="10dp" />

    <TextView android:id="@+id/rootText" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Root: checking…"
        android:textColor="@color/muted" android:textSize="13sp"
        android:padding="10dp" android:background="@color/surface" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="10dp" android:paddingBottom="10dp">
        <LinearLayout android:id="@+id/buttons" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Log (full view: the iOS Emu Logs icon)" android:textColor="@color/text" android:textStyle="bold"
        android:paddingBottom="4dp" />

    <ScrollView android:id="@+id/logScroll" android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@color/surface" android:padding="8dp">
        <TextView android:id="@+id/logText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/text"
            android:textSize="11sp" android:typeface="monospace"
            android:textIsSelectable="true" android:text="" />
    </ScrollView>
</LinearLayout>
