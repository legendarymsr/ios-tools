+/*
+ * ios-tools: the link used to be tried exactly once, when iOS turns its USB
+ * controller on. If the USB-host side was not listening yet, or restarted
+ * later, iOS never got a host again. Keep retrying every 2 s while the port
+ * is attached, and log what happens so it is visible in the QEMU log.
+ */
+static QEMUTimer *usb_tcp_host_retry_timer;
+static USBPort *usb_tcp_host_retry_port;
+static unsigned usb_tcp_host_retry_count;
+static void usb_tcp_host_attach(USBPort *port);
+
+static void usb_tcp_host_retry_cb(void *opaque)
+{
+    USBPort *port = usb_tcp_host_retry_port;
+    USBTCPHostState *s;
+
+    if (port == NULL) {
+        return;
+    }
+    s = port->opaque;
+    if (s->stopped || !s->closed || port->dev == NULL || !port->dev->attached) {
+        return;
+    }
+    usb_tcp_host_attach(port);
+}
+
+static void usb_tcp_host_schedule_retry(USBTCPHostState *s, USBPort *port)
+{
+    if (s->stopped) {
+        return;
+    }
+    if (usb_tcp_host_retry_timer == NULL) {
+        usb_tcp_host_retry_timer =
+            timer_new_ms(QEMU_CLOCK_REALTIME, usb_tcp_host_retry_cb, NULL);
+    }
+    usb_tcp_host_retry_port = port;
+    timer_mod(usb_tcp_host_retry_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 2000);
+}
+
 static void usb_tcp_host_closed(USBTCPHostState *s)
 {
+    bool was_open = s->ioc != NULL;
+
     DPRINTF("%s\n", __func__);
+    if (was_open) {
+        info_report("usb-tcp-host: link to the USB host closed");
+    }
     if (s->ioc != NULL) {
         qio_channel_shutdown(s->ioc, QIO_CHANNEL_SHUTDOWN_BOTH, NULL);
         qio_channel_close(s->ioc, NULL);
@@ -57,6 +103,10 @@ static void usb_tcp_host_closed(USBTCPHostState *s)
     }
     s->closed = true;
     migrate_del_blocker(&s->migration_blocker);
+    /* reconnect if iOS still has USB on (e.g. the USB-host VM restarted) */
+    if (was_open && usb_tcp_host_retry_port != NULL) {
+        usb_tcp_host_schedule_retry(s, usb_tcp_host_retry_port);
+    }
 }
 
